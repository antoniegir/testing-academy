{
  "name": "qa-academy-practice",
  "version": "1.0.0",
  "private": true,
  "description": "Hands-on practice: Postman, locators, TypeScript, Playwright, Git, AI in QA",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://demo.playwright.dev/todomvc",
    "ts:basics": "npx tsx src/ts-basics.ts",
    "typecheck": "tsc --noEmit",
    "test:week1": "playwright test --project=week1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
