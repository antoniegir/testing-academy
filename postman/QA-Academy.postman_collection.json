    {
      "name": "GET comments for post 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const comments = pm.response.json();          // the body as a JS array\n\npm.test('Status is 200', () => {\n    pm.response.to.have.status(200);\n});\npm.test('Response returns exactly 5 records', () => pm.expect(comments).to.have.lengthOf(5));\npm.test('Every comment has postId equal to 1', () => {\n  comments.forEach(c => pm.expect(c.postId).to.eql(1));\n});\npm.test('Every comment’s email looks valid', () => {\n  comments.forEach(c => pm.expect(c.email).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/));\n});\n"
            ]
          }
        }
      ],
