      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const schema = { type: 'object', required: ['userId','id','title','body'], properties: { userId:{type:'number'}, id:{type:'number'}, title:{type:'string'}, body:{type:'string'} } };",
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Matches JSON schema', () => pm.response.to.have.jsonSchema(schema));",
              "pm.test('id is 1', () => pm.expect(pm.response.json().id).to.eql(1));"
            ],
            "type": "text/javascript"
          }
        }
